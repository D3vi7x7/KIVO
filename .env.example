# Postmark (OTP email delivery)
# Get a server token at https://postmarkapp.com/developer/tokens
POSTMARK_API_KEY=
POSTMARK_SENDER=support@kivo.work.gd
# Echo the OTP back in the API response (development only)
DEV_OTP_IN_RESPONSE=false

# JWT signing secret - use a long random value in production
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SECURE_COOKIES=false

# Google OAuth
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
FRONTEND_URL=http://localhost:3000
